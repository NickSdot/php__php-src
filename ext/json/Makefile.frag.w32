ext\json\json_scanner.c ext\json\php_json_scanner_defs.h: $(BUILD_DIR)\json_scanner.stamp

$(BUILD_DIR)\json_scanner.stamp: $(BUILD_DIR_STAMP) ext\json\json_scanner.re ext\json\json_parser.tab.h
	$(RE2C) $(RE2C_FLAGS) -t ext/json/php_json_scanner_defs.h -bci -o ext/json/json_scanner.c ext/json/json_scanner.re
	@echo generated>$(BUILD_DIR)\json_scanner.stamp

ext\json\json_parser.tab.c ext\json\json_parser.tab.h: $(BUILD_DIR)\json_parser.stamp

$(BUILD_DIR)\json_parser.stamp: $(BUILD_DIR_STAMP) ext\json\json_parser.y
	$(BISON) $(BISON_FLAGS) --defines -l ext/json/json_parser.y -o ext/json/json_parser.tab.c
	@echo generated>$(BUILD_DIR)\json_parser.stamp
